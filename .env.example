# Copia este archivo como .env.local y completa los valores (Supabase → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
# "anon" o "publishable" key: es pública, la protege RLS
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Salta RLS. Úsala SOLO en el servidor: script de datos de prueba y rutas /api/entrevista (Fase 3).
# En Vercel va como variable de entorno normal (sin NEXT_PUBLIC_). Nunca la subas al repo.
SUPABASE_SERVICE_ROLE_KEY=

# Fase 2 · Notificaciones push (genera las claves con: npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tu-correo@ejemplo.com

# Fase 3 · Entrevista con IA (solo servidor; en Vercel: Settings → Environment Variables)
GEMINI_API_KEY=
# Opcional: modelo de Gemini (por defecto gemini-flash-lite-latest, el de más cuota gratis)
# GEMINI_MODEL=
