# Copia este archivo como .env.local y completa los valores (Supabase → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
# "anon" o "publishable" key: es pública, la protege RLS
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SOLO para el script de datos de prueba (npm run sembrar). Nunca la subas a Vercel ni al repo.
SUPABASE_SERVICE_ROLE_KEY=

# Fase 3 (entrevista con IA). Solo en el servidor.
# GEMINI_API_KEY=
